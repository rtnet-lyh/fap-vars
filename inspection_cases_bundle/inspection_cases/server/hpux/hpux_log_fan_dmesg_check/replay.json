[
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "#"
  },
  {
    "channel": "terminal",
    "action": "send",
    "matcher_type": "regex",
    "matcher_value": "^dmesg \\| egrep -i .+$"
  },
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "dmesg | egrep -i 'fan.*fail|fan.*failed|not\\s+spinning|over[- ]?temp'\r\nFAN failed: Over-temperature detected\r\n#"
  }
]
