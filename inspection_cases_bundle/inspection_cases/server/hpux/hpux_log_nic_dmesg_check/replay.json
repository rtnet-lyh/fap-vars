[
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "#"
  },
  {
    "channel": "terminal",
    "action": "send",
    "matcher_type": "regex",
    "matcher_value": "^dmesg \\| egrep -i .+$"
  },
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "dmesg | egrep -i 'link\\s+down|status\\s+down|failover|lan[0-9]+.*down'\r\nlan0: Link Down\r\n#"
  }
]
