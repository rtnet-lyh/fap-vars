[
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "#"
  },
  {
    "channel": "terminal",
    "action": "send",
    "matcher_type": "regex",
    "matcher_value": "^dmesg \\| egrep -i .+$"
  },
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "dmesg | egrep -i 'psu.*fail|power\\s+supply.*fail|power.*failed|not\\s+detected'\r\n#"
  }
]
