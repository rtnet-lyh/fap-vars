[
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "#"
  },
  {
    "channel": "terminal",
    "action": "send",
    "matcher_type": "regex",
    "matcher_value": "^dmesg \\| egrep -i .+$"
  },
  {
    "channel": "terminal",
    "action": "recv",
    "stdout": "dmesg | egrep -i 'kernel\\s+panic|\\bpanic\\b|panicking'\r\n#"
  }
]
