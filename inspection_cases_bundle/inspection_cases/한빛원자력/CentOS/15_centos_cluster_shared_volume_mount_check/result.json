      ],
      "check_script": "# -*- coding: utf-8 -*-\n\nimport re\n\nfrom items.common._base import BaseCheck\n\n\nCHECK_COMMAND = 'mount'\n\n\nclass Check(BaseCheck):\n    USE_HOST_CONNECTION = True\n    CONNECTION_METHOD = 'ssh'\n\n\n    def parse_output(self, output):\n        mounts = []\n        for line in (output or '').splitlines():\n            match = re.match(r'^(\\S+)\\s+on\\s+(\\S+)\\s+type\\s+(\\S+)\\s+\\(([^)]*)\\)', line.strip())\n            if match:\n                mounts.append({'source': match.group(1), 'mount_point': match.group(2), 'type': match.group(3), 'options': match.group(4).split(',')})\n        if not mounts:\n            return {'failure_type': 'parse_failure', 'reason': 'mount output has no parsable rows.'}\n        return {'mounts': mounts, 'mount_count': len(mounts)}\n\n    def evaluate(self, metrics, shared_volume_required, shared_volume_types, mount_option_required):\n        if metrics.get('failure_type'):\n            return 'fail'\n        types = [item.strip() for item in re.split(r'[|,\\n]+', shared_volume_types or '') if item.strip()]\n        shared = [item for item in metrics['mounts'] if item['type'] in types]\n        metrics['shared_mounts'] = shared\n        if not shared:\n            return 'fail' if shared_volume_required else 'excluded'\n        bad = [item for item in shared if mount_option_required and mount_option_required not in item['options']]\n        metrics['policy_violations'] = bad\n        return 'fail' if bad else 'ok'\n\n    def build_result(self, metrics, shared_volume_required, shared_volume_types, mount_option_required, status):\n        criteria = 'ok: shared volume type in %s and mount option contains %s' % (shared_volume_types, mount_option_required)\n        if metrics.get('failure_type'):\n            return {'message': 'shared volume check failed.', 'results': metrics.get('reason', ''), 'criteria': criteria}\n        results = 'mount_count=%d, shared_mount_count=%d' % (metrics['mount_count'], len(metrics.get('shared_mounts', [])))\n        if status == 'excluded':\n            message = 'shared volume check not applicable.'\n        else:\n            message = 'shared volume check passed.' if status == 'ok' else 'shared volume check failed policy.'\n        return {'message': message, 'results': results, 'criteria': criteria}\n\n    def run(self):\n        shared_volume_required = self.get_threshold_var('shared_volume_required', default=False, value_type='bool')\n        shared_volume_types = self.get_threshold_var('shared_volume_types', default='nfs|nfs4|cifs|gfs2|ocfs2', value_type='str')\n        mount_option_required = self.get_threshold_var('mount_option_required', default='rw', value_type='str')\n\n        rc, output, error = self._ssh(CHECK_COMMAND)\n\n        if rc != 0:\n            metrics = {\n                'failure_type': 'command_failure',\n                'rc': rc,\n                'reason': (error or output or 'command failed').strip(),\n            }\n        else:\n            metrics = self.parse_output(output)\n\n        status = self.evaluate(metrics, shared_volume_required, shared_volume_types, mount_option_required)\n        result = self.build_result(metrics, shared_volume_required, shared_volume_types, mount_option_required, status)\n\n        return self.result(\n            status=status,\n            message=result['message'],\n            metrics=metrics,\n            results=result['results'],\n            criteria=result['criteria'],\n        )\n\n\nCHECK_CLASS = Check\n",
      "check_script_lines": [
        "# -*- coding: utf-8 -*-",
        "",
        "import re",
        "",
        "from items.common._base import BaseCheck",
        "",
        "",
        "CHECK_COMMAND = 'mount'",
        "",
        "",
        "class Check(BaseCheck):",
        "    USE_HOST_CONNECTION = True",
        "    CONNECTION_METHOD = 'ssh'",
        "",
        "",
        "    def parse_output(self, output):",
        "        mounts = []",
        "        for line in (output or '').splitlines():",
        "            match = re.match(r'^(\\S+)\\s+on\\s+(\\S+)\\s+type\\s+(\\S+)\\s+\\(([^)]*)\\)', line.strip())",
        "            if match:",
        "                mounts.append({'source': match.group(1), 'mount_point': match.group(2), 'type': match.group(3), 'options': match.group(4).split(',')})",
        "        if not mounts:",
        "            return {'failure_type': 'parse_failure', 'reason': 'mount output has no parsable rows.'}",
        "        return {'mounts': mounts, 'mount_count': len(mounts)}",
        "",
        "    def evaluate(self, metrics, shared_volume_required, shared_volume_types, mount_option_required):",
        "        if metrics.get('failure_type'):",
        "            return 'fail'",
        "        types = [item.strip() for item in re.split(r'[|,\\n]+', shared_volume_types or '') if item.strip()]",
        "        shared = [item for item in metrics['mounts'] if item['type'] in types]",
        "        metrics['shared_mounts'] = shared",
        "        if not shared:",
        "            return 'fail' if shared_volume_required else 'excluded'",
        "        bad = [item for item in shared if mount_option_required and mount_option_required not in item['options']]",
        "        metrics['policy_violations'] = bad",
        "        return 'fail' if bad else 'ok'",
        "",
        "    def build_result(self, metrics, shared_volume_required, shared_volume_types, mount_option_required, status):",
        "        criteria = 'ok: shared volume type in %s and mount option contains %s' % (shared_volume_types, mount_option_required)",
        "        if metrics.get('failure_type'):",
        "            return {'message': 'shared volume check failed.', 'results': metrics.get('reason', ''), 'criteria': criteria}",
        "        results = 'mount_count=%d, shared_mount_count=%d' % (metrics['mount_count'], len(metrics.get('shared_mounts', [])))",
        "        if status == 'excluded':",
        "            message = 'shared volume check not applicable.'",
        "        else:",
        "            message = 'shared volume check passed.' if status == 'ok' else 'shared volume check failed policy.'",
        "        return {'message': message, 'results': results, 'criteria': criteria}",
        "",
        "    def run(self):",
        "        shared_volume_required = self.get_threshold_var('shared_volume_required', default=False, value_type='bool')",
        "        shared_volume_types = self.get_threshold_var('shared_volume_types', default='nfs|nfs4|cifs|gfs2|ocfs2', value_type='str')",
        "        mount_option_required = self.get_threshold_var('mount_option_required', default='rw', value_type='str')",
        "",
        "        rc, output, error = self._ssh(CHECK_COMMAND)",
        "",
        "        if rc != 0:",
        "            metrics = {",
        "                'failure_type': 'command_failure',",
        "                'rc': rc,",
        "                'reason': (error or output or 'command failed').strip(),",
        "            }",
        "        else:",
        "            metrics = self.parse_output(output)",
        "",
        "        status = self.evaluate(metrics, shared_volume_required, shared_volume_types, mount_option_required)",
        "        result = self.build_result(metrics, shared_volume_required, shared_volume_types, mount_option_required, status)",
        "",
        "        return self.result(",
        "            status=status,",
        "            message=result['message'],",
        "            metrics=metrics,",
        "            results=result['results'],",
        "            criteria=result['criteria'],",
        "        )",
        "",
        "",
        "CHECK_CLASS = Check"
      ]
    }
