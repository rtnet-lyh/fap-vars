echo "=====Physical Memory====="
PHYS_MEM=$(prtconf | awk '/Memory size:/ {printf "%.0f\n", $3/1024}')
echo "${PHYS_MEM} GB"
echo ""
echo "=====Oracle SGA Parameter====="
echo "
show parameter sga
exit;
" | sqlplus -S / as sysdba
