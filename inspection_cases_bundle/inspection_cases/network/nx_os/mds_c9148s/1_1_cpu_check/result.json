        "                continue",
        "",
        "            match = PROCESS_RE.match(stripped)",
        "            if not match:",
        "                invalid_rows.append(stripped)",
        "                continue",
        "",
        "            processes.append({",
        "                'pid': int(match.group('pid')),",
