        "    r'^\\s*(?P<pid>\\d+)\\s+\\d+\\s+\\d+\\s+\\d+\\s+'",
        "    r'(?P<cpu_5sec>[0-9.]+)%\\s+(?P<cpu_1min>[0-9.]+)%\\s+'",
        "    r'(?P<cpu_5min>[0-9.]+)%\\s+\\S+\\s+(?P<process>.+?)\\s*$'",
        ")",
        "PROMPT_RE = re.compile(r'^[A-Za-z0-9_.:/-]+[>#]\\s*$')",
