        "    def _parse_arp_entries(self, text):",
        "        entries = []",
        "        for line in (text or '').splitlines():",
        "            parts = line.split()",
        "            if len(parts) < 4 or not IP_RE.match(parts[0]) or not MAC_RE.match(parts[1]):",
        "                continue",
        "            entries.append({",
        "                'ip_address': parts[0],",
