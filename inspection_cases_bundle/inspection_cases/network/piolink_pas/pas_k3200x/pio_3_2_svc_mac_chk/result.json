        "        return self.ok(metrics=metrics, thresholds=thresholds, reasons='MAC status와 ARP state가 기준을 만족합니다.', message=f'MAC/ARP 테이블 점검 정상: MAC {len(mac_entries)}개, ARP {len(arp_entries)}개.')",
