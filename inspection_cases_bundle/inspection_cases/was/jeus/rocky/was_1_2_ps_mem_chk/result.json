        "        return self.ok(metrics=metrics, thresholds=thresholds, reasons='대상 프로세스 메모리 사용률이 기준 이하입니다.', message='JEUS 프로세스 메모리 사용률 정상: 최대 %.1f%%, 기준 %.1f%%' % (max_row['mem_percent'], threshold))",
